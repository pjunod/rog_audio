<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>AtmosProbe</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="regressions/**/*.cs" />
    <Reference Include="Cavern"><HintPath>$(CavernPath)/Cavern/bin/Release/netstandard2.1/Cavern.dll</HintPath></Reference>
    <Reference Include="Cavern.Format"><HintPath>$(CavernPath)/Cavern.Format/bin/Release/netstandard2.1/Cavern.Format.dll</HintPath></Reference>
  </ItemGroup>
</Project>
