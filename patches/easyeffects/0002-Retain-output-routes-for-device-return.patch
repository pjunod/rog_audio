+
+auto StreamOutputEffects::current_output_node(const pw::NodeInfo& event) -> pw::NodeInfo {
+  pm->lock();
+  auto node = pm->model_nodes.get_node_by_id(event.id);
+  pm->unlock();
+  // Queued events may outlive a removed sink or a reused global ID. Route
+  // descriptions must come from the current model, never the queued copy.
+  if (!pw::OutputRouteCache<QString>::same_instance(event, node) ||
+      node.name != DbStreamOutputs::outputDevice()) {
+    return {};
+  }
+  return node;
 }
 
