+#pragma once
+
+#include <cstdint>
+#include <limits>
+#include <map>
+#include <utility>
+
+namespace pw {
+
+// Accessed only in the PipeWire loop or while its lock is held. Route state
+// outlives a sink node, but not an invalidated/replaced Device enumeration.
+template <typename String>
+class OutputRouteCache {
+ public:
+  struct Route {
+    String name;
+    String description;
+    uint64_t generation;
+  };
+
+  auto remember(uint32_t device, int profile, String name, String description) -> uint64_t {
+    if (device == std::numeric_limits<uint32_t>::max() || profile < 0) {
+      return 0;
+    }
+    const auto generation = ++next_generation;
+    routes.insert_or_assign({device, profile}, Route{std::move(name), std::move(description), generation});
+    return generation;
+  }
+
+  void invalidate(uint32_t device) {
+    std::erase_if(routes, [device](const auto& item) { return item.first.first == device; });
+  }
+
+  [[nodiscard]] auto find(uint32_t device, int profile) const -> const Route* {
+    const auto item = routes.find({device, profile});
+    return item == routes.end() ? nullptr : &item->second;
+  }
+
+  [[nodiscard]] auto current(uint32_t device, int profile, uint64_t generation) const -> bool {
+    const auto* route = find(device, profile);
+    return route != nullptr && route->generation == generation;
+  }
+
+  template <typename Node>
+  [[nodiscard]] static auto same_instance(const Node& event, const Node& current_node) -> bool {
+    return event.id != std::numeric_limits<uint32_t>::max() &&
+           event.serial != std::numeric_limits<uint32_t>::max() &&
+           event.id == current_node.id && event.serial == current_node.serial;
+  }
+
+  // Enumeration invalidation cancels stale work, but retains notification
+  // history. An identical fresh route must not reset an already loaded preset.
+  template <typename Node>
+  [[nodiscard]] auto changed_since_notification(const Node& node) const -> bool {
+    const auto* route = find(node.device_id, node.profile_device);
+    if (route == nullptr || !same_instance(node, node)) {
+      return false;
+    }
+    const Notification current{node.device_id, node.profile_device, route->name, route->description};
+    const auto old = notifications.find({node.id, node.serial});
+    return old == notifications.end() || old->second != current;
+  }
+
+  template <typename Node>
+  void notified(const Node& node) {
+    if (const auto* route = find(node.device_id, node.profile_device); route != nullptr && same_instance(node, node)) {
+      notifications.insert_or_assign({node.id, node.serial},
+          Notification{node.device_id, node.profile_device, route->name, route->description});
+    }
+  }
+
+  void remove_node(uint32_t id, uint64_t serial) {
+    notifications.erase({id, serial});
+  }
+
+  void remove_device(uint32_t device) {
+    invalidate(device);
+    std::erase_if(notifications, [device](const auto& item) { return item.second.device == device; });
+  }
+
+  template <typename Node>
+  auto apply(Node& node) const -> bool {
+    const auto* route = find(node.device_id, node.profile_device);
+    const String name = route != nullptr ? route->name : String{};
+    const String description = route != nullptr ? route->description : String{};
+    if (node.device_route_name == name && node.device_route_description == description) {
+      return false;
+    }
+    node.device_route_name = name;
+    node.device_route_description = description;
+    return true;
+  }
+
+ private:
+  struct Notification {
+    uint32_t device;
+    int profile;
+    String name;
+    String description;
+    auto operator==(const Notification&) const -> bool = default;
+  };
+  std::map<std::pair<uint32_t, uint64_t>, Notification> notifications;
+  std::map<std::pair<uint32_t, int>, Route> routes;
+  uint64_t next_generation = 0;
+};
+
+}  // namespace pw
