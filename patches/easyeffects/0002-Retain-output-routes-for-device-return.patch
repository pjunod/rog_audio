 namespace pw {
 
+auto Manager::refreshOutputNodeRoute(NodeInfo& node) -> bool {
+  if (node.media_class != tags::pipewire::media_class::sink &&
+      node.media_class != tags::pipewire::media_class::virtual_sink) {
+    return false;
+  }
+  if (!output_routes.apply(node)) {
+    return false;
+  }
+  const auto stored = model_nodes.get_node_by_id(node.id);
+  // NodeManager emits a copy after sinkAdded. Hydrate that copy without a
+  // duplicate notification if sinkAdded already hydrated the actual model.
+  if (stored.device_route_name == node.device_route_name &&
+      stored.device_route_description == node.device_route_description) {
+    return false;
+  }
+  model_nodes.update_info(node);
+  return true;
+}
+
+void Manager::scheduleOutputRouteChanged(uint32_t device, int profile, uint64_t generation) {
+  // The caller is in the PipeWire loop. Create the timer on this QObject's
+  // thread, then resolve current state under the PipeWire lock when it expires.
+  QMetaObject::invokeMethod(this, [this, device, profile, generation]() {
+    QTimer::singleShot(DbMain::presetsAutoloadInterval(), this, [this, device, profile, generation]() {
+      lock();
+      if (output_routes.current(device, profile, generation)) {
+        for (auto node : model_nodes.get_nodes_by_device_id(device)) {
+          if (node.profile_device == profile &&
+              (node.media_class == tags::pipewire::media_class::sink ||
+               node.media_class == tags::pipewire::media_class::virtual_sink)) {
+            refreshOutputNodeRoute(node);
+            Q_EMIT sinkRouteChanged(node);
+          }
+        }
+      }
+      unlock();
+    });
+  }, Qt::QueuedConnection);
+}
