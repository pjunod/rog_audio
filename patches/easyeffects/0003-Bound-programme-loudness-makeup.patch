+auto Autogain::init_ebur128(uint sample_rate) -> ebur128_state* {
+  if (sample_rate == 0U) return nullptr;
+  auto* state = ebur128_init(2U, sample_rate,
+                           EBUR128_MODE_S | EBUR128_MODE_I | EBUR128_MODE_LRA | EBUR128_MODE_SAMPLE_PEAK);
+  if (state == nullptr) return nullptr;
+  if (ebur128_set_channel(state, 0U, EBUR128_LEFT) != EBUR128_SUCCESS ||
+      ebur128_set_channel(state, 1U, EBUR128_RIGHT) != EBUR128_SUCCESS) {
+    ebur128_destroy(&state);
+    return nullptr;
+  }
+  return state;
+}
