diff --git a/src/programme_analyser_state.hpp b/src/programme_analyser_state.hpp
new file mode 100644
--- /dev/null
+++ b/src/programme_analyser_state.hpp
@@ -0,0 +1,94 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <cstdint>
+#include <memory>
+#include <mutex>
+#include <utility>
+
+namespace programme_loudness {
+// Library state is only borrowed while with_state holds its mutex. Builders
+// allocate on the worker, never on the processing thread. A stale builder
+// cannot publish over a newer format/reset generation. Retired state is
+// destroyed after publication unlocks, with no outstanding borrowed state.
+template <typename State, typename Deleter>
+class AnalyserState {
+ public:
+  struct Request {
+    std::uint64_t generation;
+    unsigned int rate;
+  };
+
+  bool ready_for(unsigned int rate) const {
+    std::scoped_lock lock(mutex_);
+    return ready_ && rate_ == rate;
+  }
+
+  Request request(unsigned int rate) {
+    std::scoped_lock lock(mutex_);
+    ready_ = false;
+    rate_ = rate;
+    return {++generation_, rate};
+  }
+
+  void invalidate() {
+    std::scoped_lock lock(mutex_);
+    ready_ = false;
+    ++generation_;
+  }
+
+  template <typename Configure>
+  bool set_history(int seconds, Configure&& configure) {
+    std::scoped_lock lock(mutex_);
+    history_ = seconds;
+    if (state_ && !configure(state_.get(), history_)) {
+      ready_ = false;
+      return false;
+    }
+    return true;
+  }
+
+  template <typename Build, typename Configure>
+  bool replace(Request requested, Build&& build, Configure&& configure) {
+    // Allocation and a rejected candidate's destruction happen on this worker.
+    Pointer candidate(build(requested.rate));
+    Pointer retired;
+    {
+      std::scoped_lock lock(mutex_);
+      if (requested.generation != generation_ || requested.rate != rate_ ||
+          !candidate || !configure(candidate.get(), history_)) {
+        return false;
+      }
+      retired = std::move(state_);
+      state_ = std::move(candidate);
+      ready_ = true;
+    }
+    return true;
+  }
+
+  template <typename Use>
+  decltype(auto) with_state(Use&& use) {
+    std::scoped_lock lock(mutex_);
+    // Callbacks must not retain the pointer beyond this lease.
+    return std::forward<Use>(use)(ready_ ? state_.get() : nullptr);
+  }
+
+  void clear() {
+    Pointer retired;
+    {
+      std::scoped_lock lock(mutex_);
+      ready_ = false;
+      ++generation_;
+      retired = std::move(state_);
+    }
+  }
+
+ private:
+  using Pointer = std::unique_ptr<State, Deleter>;
+  mutable std::mutex mutex_;
+  Pointer state_;
+  std::uint64_t generation_ = 0;
+  unsigned int rate_ = 0;
+  int history_ = 15;
+  bool ready_ = false;
+};
+}  // namespace programme_loudness
diff --git a/src/programme_makeup_gain.hpp b/src/programme_makeup_gain.hpp
new file mode 100644
--- /dev/null
+++ b/src/programme_makeup_gain.hpp
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#pragma once
+#include <algorithm>
+#include <cmath>
+
+namespace programme_loudness {
+// Maximum gain controls automatic makeup, separately from the LUFS target.
+// The final limiter handles peaks while this gain follows the existing
+// 100 ms attack / 400 ms release smoothing convention.
+class MakeupGain {
+ public:
+  void reset() { value_ = 1.0; }
+  double value() const { return value_; }
+  double update(double requested, double maximum_db, double attack,
+                double release, bool active) {
+    const double limit = std::isfinite(maximum_db)
+                             ? std::pow(10.0, std::clamp(maximum_db, 0.0, 36.0) / 20.0)
+                             : 1.0;
+    // An explicit lower cap takes effect before smoothing, so old state
+    // cannot retain makeup above the newly selected limit.
+    value_ = std::clamp(std::isfinite(value_) ? value_ : 1.0, 0.0, limit);
+    if (!active || !std::isfinite(requested) || requested < 0.0 ||
+        !std::isfinite(attack) || !std::isfinite(release)) {
+      reset();
+      return value_;
+    }
+    const double target = std::clamp(requested, 0.0, limit);
+    const double alpha = std::clamp(target < value_ ? attack : release, 0.0, 1.0);
+    value_ = std::clamp(alpha * value_ + (1.0 - alpha) * target, 0.0, limit);
+    return value_;
+  }
+ private:
+  double value_ = 1.0;
+};
+}  // namespace programme_loudness
