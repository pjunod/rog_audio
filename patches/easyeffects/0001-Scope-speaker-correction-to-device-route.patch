diff --git a/src/speaker_routing.hpp b/src/speaker_routing.hpp
new file mode 100644
index 0000000..7d98746
--- /dev/null
+++ b/src/speaker_routing.hpp
@@ -0,0 +1,176 @@
+/**
+ * Copyright © 2026 rog_audio contributors
+ * SPDX-License-Identifier: GPL-3.0-or-later
+ * This routing extension is distributed under the same terms as EasyEffects.
+ */
+#pragma once
+
+#include <atomic>
+#include <cstdint>
+#include <deque>
+#include <functional>
+#include <map>
+#include <optional>
+#include <string>
+#include <utility>
+
+namespace pw {
+
+// Every mutation runs under the PipeWire loop lock. Only correction_active is
+// read by DSP threads. Scope strings are immutable for the lifetime of the app.
+class SpeakerRouting {
+ public:
+  struct Property {
+    std::string type, value;
+    auto operator==(const Property&) const -> bool = default;
+  };
+  using Value = std::optional<Property>;
+  using Key = std::pair<uint32_t, std::string>;
+  using Writer = std::function<void(uint32_t, const std::string&, const Value&)>;
+  struct Node {
+    uint64_t serial;
+    std::string name;
+    bool output_stream, blocked;
+    uint32_t device;
+    int profile_device;
+    std::string property_target;
+  };
+  struct Link { uint32_t output, input; };
+  struct Owned { uint64_t serial; Value node, object; };
+
+  const std::string device_name, route_name;
+  const bool scoped;
+  std::atomic<bool> correction_active{false};
+  bool ready = false, process_outputs = true, metadata_available = false;
+  std::string selected_output, default_output;
+  std::map<uint32_t, Node> nodes;
+  std::map<uint32_t, Link> links;
+  std::map<std::pair<uint32_t,int>, std::string> routes;
+  std::map<Key, Value> targets;
+  std::map<Key, std::deque<Value>> pending;
+  std::map<uint32_t, Owned> owned;
+  Writer writer;
+  uint32_t effects_id = UINT32_MAX;
+  uint64_t effects_serial = UINT64_MAX;
+
+  SpeakerRouting(std::string device, std::string route, Writer write)
+      : device_name(std::move(device)), route_name(std::move(route)),
+        scoped(!device_name.empty() || !route_name.empty()), writer(std::move(write)) {}
+
+  auto bypass() const -> bool {
+    return scoped && !correction_active.load(std::memory_order_acquire);
+  }
+
+  auto value(uint32_t id, const std::string& key) const -> Value {
+    auto it = targets.find({id,key});
+    return it == targets.end() ? Value{} : it->second;
+  }
+
+  auto expected(const std::string& key) const -> Value {
+    return Property{"Spa:Id",std::to_string(key == "target.node" ? effects_id : effects_serial)};
+  }
+
+  void write(uint32_t id, const std::string& key, const Value& v) {
+    // Update our cache before the asynchronous echo. Pending writes prevent an
+    // old acknowledgment from being mistaken for a new explicit app target.
+    if (value(id,key) == v) return;
+    targets[{id,key}] = v;
+    pending[{id,key}].push_back(v);
+    writer(id,key,v);
+  }
+
+  void release(uint32_t id) {
+    auto it=owned.find(id);
+    if (it==owned.end()) return;
+    auto original=it->second;
+    owned.erase(it);
+    if (value(id,"target.node")==expected("target.node")) write(id,"target.node",original.node);
+    if (value(id,"target.object")==expected("target.object")) write(id,"target.object",original.object);
+  }
+
+  void release_all() {
+    while (!owned.empty()) release(owned.begin()->first);
+  }
+
+  void target_changed(uint32_t id, const std::string& key, Value v) {
+    if (key.empty()) {
+      targets.erase({id,"target.node"}); targets.erase({id,"target.object"});
+      pending.erase({id,"target.node"}); pending.erase({id,"target.object"});
+      owned.erase(id);
+      return;
+    }
+    if (key!="target.node" && key!="target.object") return;
+    auto& queue=pending[{id,key}];
+    if (!queue.empty() && queue.front()==v) { queue.pop_front(); return; }
+    targets[{id,key}]=std::move(v);
+    // A target supplied by another client wins. Restore only the other key if
+    // it is still ours; never clear the new HDMI/USB/application choice.
+    if (owned.contains(id) && value(id,key)!=expected(key)) release(id);
+    refresh();
+  }
+
+  void node_changed(uint32_t id, Node node) {
+    auto it=nodes.find(id);
+    if (it!=nodes.end() && it->second.serial!=node.serial) node_removed(id);
+    nodes.insert_or_assign(id,std::move(node)); refresh();
+  }
+
+  void node_removed(uint32_t id) {
+    nodes.erase(id); owned.erase(id);
+    targets.erase({id,"target.node"}); targets.erase({id,"target.object"});
+    pending.erase({id,"target.node"}); pending.erase({id,"target.object"});
+    for (auto it=links.begin();it!=links.end();) {
+      if (it->second.output==id || it->second.input==id) it=links.erase(it); else ++it;
+    }
+    refresh();
+  }
+
+  auto scoped_sink() const -> std::optional<std::pair<uint32_t,Node>> {
+    for (const auto& [id,node]:nodes) if (node.name==device_name) return std::pair{id,node};
+    return {};
+  }
+
+  auto points_to_sink(const Value& v, const Node& sink, uint32_t id, bool object) const -> bool {
+    if (!v) return true;
+    return v->value==sink.name || v->value==std::to_string(object ? sink.serial : id);
+  }
+
+  auto explicit_target(const Node& node, uint32_t id) const -> bool {
+    return value(id,"target.node").has_value() || value(id,"target.object").has_value() ||
+           !node.property_target.empty();
+  }
+
+  void refresh() {
+    if (!scoped) return;
+    auto sink=scoped_sink();
+    bool active=ready && metadata_available && !route_name.empty() && sink.has_value() &&
+                selected_output==device_name &&
+                routes[{sink->second.device,sink->second.profile_device}]==route_name;
+    correction_active.store(active,std::memory_order_release);
+    for (auto it=owned.begin();it!=owned.end();) {
+      auto id=it++->first; const auto& original=owned.at(id); auto n=nodes.find(id);
+      if (!active || !process_outputs || n==nodes.end() || n->second.blocked ||
+          n->second.serial!=original.serial ||
+          (!n->second.property_target.empty() && n->second.property_target!=device_name &&
+           (!sink || n->second.property_target!=std::to_string(sink->second.serial))) ||
+          (!original.node && !original.object && n->second.property_target.empty() && default_output!=device_name))
+        release(id);
+    }
+    if (!active || !process_outputs || effects_id==UINT32_MAX || effects_serial==UINT64_MAX) return;
+    for (const auto& [link_id,link]:links) {
+      if (link.input!=sink->first || owned.contains(link.output)) continue;
+      auto it=nodes.find(link.output);
+      if (it==nodes.end() || !it->second.output_stream || it->second.blocked) continue;
+      auto id=it->first; const auto& node=it->second;
+      if (!points_to_sink(value(id,"target.object"),sink->second,sink->first,true) ||
+          !points_to_sink(value(id,"target.node"),sink->second,sink->first,false) ||
+          (!node.property_target.empty() && node.property_target!=device_name &&
+           node.property_target!=std::to_string(sink->second.serial)) ||
+          (!explicit_target(node,id) && default_output!=device_name)) continue;
+      owned.emplace(id,Owned{node.serial,value(id,"target.node"),value(id,"target.object")});
+      write(id,"target.node",expected("target.node"));
+      write(id,"target.object",expected("target.object"));
+    }
+  }
+};
+} // namespace pw
